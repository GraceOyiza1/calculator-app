generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  createdAt DateTime @default(now())
}

model PackagingSpec {
  id                 String   @id @default(uuid())
  materialType       String   @unique
  costPerSqFt        Float
  dimensionalDivisor Float    @default(139.0)
  createdAt          DateTime @default(now())
}
